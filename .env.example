# Copiar a .env y completar. El .env y la carpeta wallet/ estan en .gitignore.
# <servicio> es el nombre que aparece en wallet/tnsnames.ora (por ejemplo midb_tp).

# Ejecutando con Docker (el wallet se monta en /app/wallet):
DB_URL=jdbc:oracle:thin:@<servicio>_tp?TNS_ADMIN=/app/wallet
# Ejecutando local con mvnw, usa la ruta real, por ejemplo:
# DB_URL=jdbc:oracle:thin:@<servicio>_tp?TNS_ADMIN=C:/dev/pet-api-oracle/wallet

DB_USERNAME=<usuario>
DB_PASSWORD=<contrasena>
# Frontend con ng serve (4200) y con Docker (4000)
CORS_ORIGINS=http://localhost:4200,http://localhost:4000
